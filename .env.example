# -----------------------------------------------------------------------------
# TAIGA MODERN FRONTEND - CONFIGURACIÓN DE ENTORNO
# -----------------------------------------------------------------------------
# Compatible al 100% con los valores del docker-compose oficial de Taiga.
# -----------------------------------------------------------------------------

# URL base pública de Taiga (donde está alojado el backend/gateway)
# Ejemplo: https://planning.filup.mx o http://localhost:9000
TAIGA_URL=https://planning.filup.mx

# URL WebSocket para eventos en tiempo real
# Ejemplo: wss://planning.filup.mx o ws://localhost:9000
TAIGA_WEBSOCKETS_URL=wss://planning.filup.mx

# Subruta opcional de Taiga si corre bajo un subpath (ej. /taiga)
TAIGA_SUBPATH=

# Variables opcionales para sobrescritura granular (tienen prioridad si se definen):
# VITE_API_BASE_URL=/api/v1
# VITE_EVENTS_URL=wss://planning.filup.mx/events

# Identidad visual y marca por defecto (White-label)
VITE_DEFAULT_APP_TITLE=planning
VITE_DEFAULT_COMPANY_NAME=""

