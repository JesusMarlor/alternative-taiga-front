# -----------------------------------------------------------------------------
# TAIGA MODERN FRONTEND - CONFIGURACIÓN DE ENTORNO
# -----------------------------------------------------------------------------
# Copia este archivo como '.env' para tu entorno local:
#   cp .env.example .env
# -----------------------------------------------------------------------------

# URL base del API REST de Taiga
# En desarrollo local con Vite se recomienda '/api/v1' para usar el proxy automático
# En producción puedes apuntar a '/api/v1' o a la URL pública (ej. https://taiga.tuempresa.com/api/v1)
VITE_API_BASE_URL=/api/v1

# URL del servidor WebSocket para eventos en tiempo real (taiga-events)
# Ejemplo: wss://taiga.tuempresa.com/events o ws://localhost:8888/events
VITE_EVENTS_URL=wss://taiga.tuempresa.com/events

# Servidor destino de Taiga para el proxy de Vite en desarrollo local
# (Evita problemas de CORS al desarrollar en localhost)
VITE_TAIGA_BACKEND_URL=https://taiga.tuempresa.com

# Identidad visual y marca por defecto (White-label)
VITE_DEFAULT_APP_TITLE=planning
VITE_DEFAULT_COMPANY_NAME=""
